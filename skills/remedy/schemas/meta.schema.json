{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixit-plugin/meta",
  "title": "Programme meta",
  "type": "object",
  "required": [
    "title",
    "planDir",
    "waves",
    "clusters",
    "protocol"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "planDir": {
      "type": "string"
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "protocol": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded": {
      "type": "string"
    },
    "reservedIds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string"
          },
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          },
          "owner": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cluster": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "trackerUrl": {
          "type": "string"
        },
        "registerUrl": {
          "type": "string"
        }
      }
    }
  }
}