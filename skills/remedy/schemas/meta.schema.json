{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixit-plugin/meta",
  "title": "Programme meta",
  "type": "object",
  "required": [
    "title",
    "planDir",
    "waves",
    "clusters",
    "protocol"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "planDir": {
      "type": "string"
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "protocol": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded": {
      "type": "string"
    },
    "reservedIds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string"
          },
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          },
          "owner": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cluster": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "trackerUrl": {
          "type": "string"
        },
        "registerUrl": {
          "type": "string"
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Aliases only, never dated model ids. All keys optional; defaults are in scripts/route.cjs.",
      "properties": {
        "coordinator": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "triager": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "auditHunter": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "auditHunterDeep": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "auditVerifier": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "campaignAuthor": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "tester": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "investigator": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "planner": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "builder": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "builderRisk": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "builderMechanical": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "builderEscalation": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "reviewer": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "inherit"
          ]
        },
        "riskPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riskPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effort": {
          "type": "object",
          "properties": {
            "opus": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "sonnet": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "haiku": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        },
        "budgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "mainBranch": {
      "type": "string",
      "description": "Branch `remedy done` compares a commit against (default origin/HEAD, else main)."
    }
  }
}
