#!/bin/sh
# Resolves symlinks, then runs the plugin's CLI with node. Works from any directory.
self=$0
while [ -L "$self" ]; do
  d=$(dirname -- "$self"); l=$(readlink -- "$self")
  case $l in /*) self=$l ;; *) self=$d/$l ;; esac
done
dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P) || exit 2
exec node "$dir/../skills/remedy/scripts/remedy.cjs" "$@"
